            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "workingdays",
        "working days api",
        "free working days api",
        "business days api",
        "number of working days per month",
        "count working days"
    ],
    "homepage": "https://apiverve.com/marketplace/workingdays?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/workingdays",
        "source": "https://github.com/apiverve/workingdays-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
